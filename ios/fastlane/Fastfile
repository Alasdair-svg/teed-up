default_platform(:ios)

platform :ios do
  desc 'Push a new beta build to TestFlight'
  lane :beta do
    key_path = File.expand_path("keys/AuthKey_98UDF59KU7.p8", __dir__)

    app_store_connect_api_key(
      key_id: "98UDF59KU7",
      issuer_id: "32df2f83-b463-468f-95aa-f43b10192828",
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    # Regenerate Generated.xcconfig from pubspec before archiving.
    #
    # gym drives xcodebuild directly, so it uses whatever version Flutter
    # last wrote — which is not refreshed by an Android build, or by any
    # command that doesn't touch iOS. Build 63 shipped with the marketing
    # version from a stale config (1.11.1) while Android shipped 1.11.2 off
    # the same commit. --config-only rewrites it from pubspec.yaml in a
    # second, without building.
    sh('cd ../.. && flutter build ios --config-only')

    # The Share Extension IS registered (com.teedup.golf.ShareExtension,
    # 9TLT7SCA57) and IS signed in Release; only Debug and Profile disable
    # signing. Both App IDs carry the APP_GROUPS capability for
    # group.com.teedup.golf.share — run the refresh_profiles lane if a profile
    # predates that and the archive fails on the entitlement.
    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: 'Runner',
      export_method: 'app-store',
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath '#{key_path}' -authenticationKeyID 98UDF59KU7 -authenticationKeyIssuerID 32df2f83-b463-468f-95aa-f43b10192828 ENABLE_BITCODE=NO"
    )

    # "What to Test" — testers saw an empty panel on every previous build,
    # so nobody knew what had changed or what to exercise. Kept in step with
    # the Play changelog for the same version code.
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: File.read(File.expand_path('metadata/whats_new.txt', __dir__))
    )
  end

  desc 'Regenerate the App Store provisioning profiles so they carry current entitlements'
  desc 'Needed after adding a capability: an existing profile does not pick up a new'
  desc 'entitlement, and the archive fails with "does not match the entitlements file".'
  lane :refresh_profiles do
    key_path = File.expand_path("keys/AuthKey_98UDF59KU7.p8", __dir__)
    api_key = app_store_connect_api_key(
      key_id: "98UDF59KU7",
      issuer_id: "32df2f83-b463-468f-95aa-f43b10192828",
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    %w[com.teedup.golf com.teedup.golf.ShareExtension].each do |bundle_id|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: bundle_id,
        force: true,
        output_path: File.expand_path("profiles", __dir__)
      )
      UI.important "#{bundle_id} -> #{lane_context[SharedValues::SIGH_NAME]}"
    end
  end

  desc 'Push a new release to App Store'
  lane :release do
    key_path = File.expand_path("keys/AuthKey_98UDF59KU7.p8", __dir__)

    app_store_connect_api_key(
      key_id: "98UDF59KU7",
      issuer_id: "32df2f83-b463-468f-95aa-f43b10192828",
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: 'Runner',
      export_method: 'app-store',
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath '#{key_path}' -authenticationKeyID 98UDF59KU7 -authenticationKeyIssuerID 32df2f83-b463-468f-95aa-f43b10192828 ENABLE_BITCODE=NO"
    )
    upload_to_app_store(
      force: true,
      submit_for_review: false
    )
  end

  desc 'Sync App Store Connect listing text, screenshots, and age rating — no binary upload'
  lane :metadata do
    key_id = ENV['ASC_KEY_ID'] || "98UDF59KU7"
    issuer_id = ENV['ASC_ISSUER_ID'] || "32df2f83-b463-468f-95aa-f43b10192828"
    key_path = ENV['ASC_KEY_PATH'] || File.expand_path("keys/AuthKey_#{key_id}.p8", __dir__)

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    # Works around fastlane/fastlane#20538: on an app's very first App Store
    # version, fetch_app_store_review_detail raises "No data" because Apple
    # hasn't materialized a review-detail resource yet. We never set
    # app_review_attachment_file, so this step is a no-op for us regardless —
    # skip it rather than let an unrelated Apple API quirk fail a run that
    # already successfully pushed name/subtitle/description/keywords.
    require 'deliver/upload_metadata'
    Deliver::UploadMetadata.class_eval do
      def review_attachment_file(version)
        UI.message("Skipping review attachment sync (not used)")
      end
    end

    upload_to_app_store(
      skip_binary_upload: true,
      # KNOWN ISSUE: fastlane's screenshot upload verification step can
      # declare uploads "missing" while Apple is still processing them, then
      # retries a full re-upload — producing genuine duplicates (confirmed:
      # a clean 5-file run landed as 10 in App Store Connect on 2026-08-21,
      # reproducibly, even with overwrite_screenshots below). If you push a
      # screenshots change and later spot doubles in App Store Connect's
      # Media Manager, that's this — Delete All for the affected locale and
      # re-upload the 5 files directly via the ASC web UI rather than
      # re-running this lane again.
      skip_screenshots: false,
      overwrite_screenshots: true,
      skip_app_version_update: false,
      force: true,
      submit_for_review: false,
      # Age Rating (App Store Connect's Age Rating Declaration) uploads via
      # the same JWT-authenticated Connect API as the rest of this lane —
      # unlike the App Privacy "nutrition label", which fastlane's
      # upload_app_privacy_details_to_app_store only supports via legacy
      # interactive Apple ID login and can't run here.
      app_rating_config_path: File.expand_path("age_rating_config.json", __dir__),
      # We never submit for review from this lane, so App Store guideline
      # precheck is irrelevant — and it can't inspect in-app purchases when
      # authenticated via API key (only Apple ID login supports that),
      # which errors out on this app's IAP otherwise.
      run_precheck_before_submit: false
    )
  end

  desc 'One-time bootstrap: create/install a Distribution certificate + private key in this Mac keychain via the ASC API key (no interactive Apple ID login)'
  lane :bootstrap_cert do
    key_path = File.expand_path("keys/AuthKey_98UDF59KU7.p8", __dir__)

    app_store_connect_api_key(
      key_id: "98UDF59KU7",
      issuer_id: "32df2f83-b463-468f-95aa-f43b10192828",
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    get_certificates(
      output_path: File.expand_path("certs", __dir__)
    )

    # The existing named profiles were bound to whatever certificate they
    # were created with — now gone from this keychain. Regenerate both so
    # they include the certificate get_certificates just installed, rather
    # than relying on -allowProvisioningUpdates (its auto-repair behavior
    # applies to Automatic signing; both targets here use Manual).
    get_provisioning_profile(
      app_identifier: "com.teedup.golf",
      provisioning_name: "All Teed Up AppStore Profile",
      filename: "AllTeedUp_AppStore.mobileprovision",
      force: true
    )
    get_provisioning_profile(
      app_identifier: "com.teedup.golf.ShareExtension",
      provisioning_name: "All Teed Up ShareExtension AppStore Profile",
      filename: "AllTeedUpShareExtension_AppStore.mobileprovision",
      force: true
    )
  end
end
