default_platform(:ios)

platform :ios do
  desc 'Push a new beta build to TestFlight'
  lane :beta do
    app_store_connect_api_key(
      key_id: "93D3TRQ9HM",
      issuer_id: "32df2f83-b463-468f-95aa-f43b10192828",
      key_filepath: "fastlane/keys/AuthKey_93D3TRQ9HM.p8",
      duration: 1200,
      in_house: false
    )
    
    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: 'Runner',
      export_method: 'app-store'
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc 'Push a new release to App Store'
  lane :release do
    app_store_connect_api_key(
      key_id: "93D3TRQ9HM",
      issuer_id: "32df2f83-b463-468f-95aa-f43b10192828",
      key_filepath: "fastlane/keys/AuthKey_93D3TRQ9HM.p8",
      duration: 1200,
      in_house: false
    )

    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: 'Runner',
      export_method: 'app-store'
    )
    upload_to_app_store(
      force: true,
      submit_for_review: false
    )
  end
end
